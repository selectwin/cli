{
  "name": "@selectwin/cli",
  "version": "0.1.7",
  "description": "Selectwin command-line interface — authenticate, call any endpoint, and manage resources from your terminal.",
  "keywords": [
    "selectwin",
    "cli",
    "payments",
    "api",
    "oclif"
  ],
  "homepage": "https://github.com/selectwin/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selectwin/cli.git"
  },
  "license": "MIT",
  "author": "Selectwin",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "selectwin": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "/README.md",
    "/LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-help": "^6.2.53",
    "@selectwin/sdk": "^0.1.2",
    "chalk": "^5.3.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.0.0",
    "@types/node": "^22.0.0",
    "oclif": "^4.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "oclif": {
    "bin": "selectwin",
    "dirname": "selectwin",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "config": {
        "description": "manage CLI profiles (~/.selectwin/config.toml)"
      },
      "transactions": {
        "description": "create, list and manage transactions"
      },
      "customers": {
        "description": "create, list and manage customers"
      },
      "webhooks": {
        "description": "manage webhook endpoints and test deliveries"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist oclif.manifest.json tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build && oclif manifest",
    "postpack": "rm -f oclif.manifest.json",
    "dev": "tsx ./bin/dev.js"
  }
}
